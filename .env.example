# Copy to .env and adjust. Every variable is optional; defaults live in src/creatorops/config.py.
# Never commit .env.

# --- General ---
CREATOROPS_SEED=42
CREATOROPS_LOG_LEVEL=INFO

# --- Paths (default: ./data, ./data/manifest.csv, ./data/creatorops.sqlite) ---
# CREATOROPS_DATA_DIR=./data
# CREATOROPS_DB_PATH=./data/creatorops.sqlite

# --- Vector store: "local" (embedded, no Docker) or "server" (docker compose up qdrant) ---
CREATOROPS_QDRANT_MODE=local
CREATOROPS_QDRANT_URL=http://localhost:6333
CREATOROPS_QDRANT_COLLECTION=creatorops_chunks

# --- Retrieval ---
CREATOROPS_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
CREATOROPS_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
CREATOROPS_RETRIEVAL_TOP_K=10

# --- LLM: "ollama" (local) or "fake" (deterministic, tests/CI) ---
CREATOROPS_LLM_PROVIDER=ollama
CREATOROPS_OLLAMA_BASE_URL=http://localhost:11434
CREATOROPS_OLLAMA_MODEL=qwen3:8b
CREATOROPS_OLLAMA_JUDGE_MODEL=qwen3:14b
CREATOROPS_LLM_TEMPERATURE=0.0
CREATOROPS_LLM_TIMEOUT_S=120

# --- SQL guardrails ---
CREATOROPS_SQL_ROW_LIMIT=200
CREATOROPS_SQL_TIMEOUT_S=5

# --- Experiment tracking ---
# CREATOROPS_MLFLOW_TRACKING_URI=file:./mlruns

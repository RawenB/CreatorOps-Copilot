# copy this file to .env and change what you need (all values are optional)

CREATOROPS_SEED=42

# vector store: local (no docker) or server (docker compose up -d qdrant)
CREATOROPS_QDRANT_MODE=local
CREATOROPS_QDRANT_URL=http://localhost:6333

CREATOROPS_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
CREATOROPS_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
CREATOROPS_TOP_K=10

# llm: ollama or fake
CREATOROPS_LLM_PROVIDER=ollama
CREATOROPS_OLLAMA_URL=http://localhost:11434
CREATOROPS_OLLAMA_MODEL=qwen3:8b

CREATOROPS_SQL_MAX_ROWS=200
CREATOROPS_SQL_TIMEOUT_S=5

# after the first run (models downloaded) this avoids slow network checks to Hugging Face
# HF_HUB_OFFLINE=1
